{
  "name": "takemebacktojapan",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Take Me Back to Japan (takemebacktojapan.com): a first-person, anime-style stroll through Fujikawaguchikko, a small town under Mt. Fuji. Fork of Sakura Crossing (MIT).",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --mode mobile",
    "preview": "vite preview",
    "play": "vite build && vite preview --port 5179 --open",
    "shots": "node scripts/shots.mjs",
    "check:names": "node scripts/check-names.mjs",
    "audio": "node scripts/encode-audio.mjs",
    "size": "node scripts/size.mjs",
    "size:mobile": "node scripts/size-mobile.mjs",
    "dev:phone": "vite --host 0.0.0.0 --port 5195",
    "fonts": "node scripts/subset-fonts.mjs"
  },
  "dependencies": {
    "three": "^0.180.0"
  },
  "devDependencies": {
    "playwright": "^1.63.0",
    "vite": "^6.0.0"
  }
}
